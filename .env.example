# 可选：网站访问密码（留空或不设置时公开访问；管理员后台仍独立认证）
PASSWORD=

# 可选：直播功能总开关；true=开启，false=关闭，默认开启。EdgeOne 修改后需重新部署。
LIVE_ENABLED=true

# 可选：前台设置总开关；true=开启，false=关闭，默认开启。修改后需重新部署并刷新页面。
SETTINGS_ENABLED=true

# Logo：A=影院经典，B=醒目识别，C=灯塔光影；默认 A。构建时读取，修改后必须重新部署。
NEXT_PUBLIC_LOGO_STYLE=A

# 可选：真实后台，所有以下凭据仅服务端读取；不要填入公开仓库。
# ADMIN_PASSWORD_HASH=<salt-hex>:<scrypt-hash-hex>
# ADMIN_SESSION_SECRET=<random-secret>
# ADMIN_ORIGIN=https://04320.com
# EDGEONE_PROJECT_ID=<project-id>
# EDGEONE_API_TOKEN=<api-token>

# 以下公开配置在构建时内联，由后台保存后自动重新构建。
# NEXT_PUBLIC_SITE_NAME=04320TV
# NEXT_PUBLIC_SITE_SUBTITLE=光影之间
# NEXT_PUBLIC_SITE_DESCRIPTION=搜索电影、剧集，找到下一段光影。
# NEXT_PUBLIC_SITE_ANNOUNCEMENT=有些故事，仍在等你。
# NEXT_PUBLIC_RECOMMENDATIONS_ENABLED=true
# NEXT_PUBLIC_DEFAULT_AUTOPLAY=true
# NEXT_PUBLIC_DEFAULT_AD_FILTER=true
# NEXT_PUBLIC_DEFAULT_ADULT_FILTER=true

# 可选：会话/代理签名密钥；不设置时从 PASSWORD 派生
# PROXY_SECRET=

# 可选：Cookie Secure 策略覆盖（true=强制开启 / false=强制关闭；不设置时按请求协议自动推导，HTTP 部署无需配置）
# COOKIE_SECURE=

# 可选：代理请求上游的超时与重试
REQUEST_TIMEOUT=8000
MAX_RETRIES=1

# 可选：影视榜单推荐源（60s API）实例地址，默认官方公共实例 https://60s.viki.moe。
# 官方实例有限流（本项目每小时仅请求 6 次榜单，通常够用）；高频使用可自部署：docker run -d -p 4399:4399 vikiboss/60s:latest
# 60S_API_BASE=https://60s.viki.moe

# 可选：调试
DEBUG=false

# 可选：固定使用某个发布镜像版本（默认不设置 = ghcr.io/librespark/libretv:latest，
# 首次部署先 docker compose pull 拉取；本地开发可用 docker compose up -d --build 构建）
# LIBRETV_IMAGE=ghcr.io/librespark/libretv:2.0.1
# 邮件订阅：前台样式与开关，保存后台后重新部署生效。
NEXT_PUBLIC_NEWSLETTER_ENABLED=false
NEXT_PUBLIC_NEWSLETTER_STYLE=lighthouse
# 仅服务端使用，指向 Cloudflare 转发项目的受保护订阅接口；勿使用 mailproxy.php。
NEWSLETTER_API_URL=
NEWSLETTER_API_KEY=
